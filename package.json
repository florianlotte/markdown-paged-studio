{
  "name": "markdown-paged-studio",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder --publish never",
    "desktop:dir": "vite build && electron-builder --dir --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test tests/mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "pagedjs": "^0.4.3",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "description": "Write Markdown, add custom CSS and get a paginated, print-ready document with cover page, headers, footers, page numbers and Mermaid diagrams. 100% in the browser.",
  "keywords": [
    "markdown",
    "pagedjs",
    "print",
    "pdf",
    "mermaid",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "author": {
    "name": "Florian Lotte"
  },
  "bin": {
    "markdown-paged-studio-mcp": "mcp/server.mjs"
  }
}
